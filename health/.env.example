# Copy to .env and edit. .env is gitignored.

# Token the phone presents on every upload. Generate with:
#   openssl rand -hex 32
INGEST_TOKEN=changeme-generate-a-real-token

# Local timezone. Drives local-day boundaries in every dashboard, so a day
# runs local-midnight to local-midnight rather than UTC.
LOCAL_TIMEZONE=America/New_York

POSTGRES_USER=health
POSTGRES_PASSWORD=health
POSTGRES_DB=health

# Grafana reads through a separate read-only role - it never gets the
# credentials that can write to the health record.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=grafana_ro

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

DB_PORT=5433
INGEST_PORT=8000
GRAFANA_PORT=3001
