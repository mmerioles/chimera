    {
      "type": "stat",
      "title": "Unlocks per day",
      "description": "Mean pickups per day over the last 7 complete days. Tracks compulsive checking separately from time spent.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(unlocks) AS \"Unlocks per day\"\nFROM health.v_screentime_daily\nWHERE day >= health.local_day(now()) - interval '7 days'\n  AND day <  health.local_day(now())",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
