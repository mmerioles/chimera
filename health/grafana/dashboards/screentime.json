    {
      "type": "timeseries",
      "title": "Daily screen time",
      "description": "Total foreground time per local day, with a trailing 7-day mean. The mean is computed over the visible range, so the first six points of any range are partial windows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS time,\n       screen_time_hours AS \"Daily\",\n       AVG(screen_time_hours) OVER (\n         ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n       ) AS \"7-day mean\"\nFROM health.v_screentime_daily\nWHERE $__timeFilter(day)\nORDER BY day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "barAlignment": 0,
            "barWidthFactor": 0.7,
            "axisLabel": "hours",
            "axisPlacement": "left",
            "gradientMode": "none",
            "showPoints": "never",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "7-day mean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineInterpolation",
                "value": "smooth"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 5
    },
    {
      "type": "barchart",
      "title": "Top apps in range",
      "description": "Total foreground hours per app across the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT app AS \"App\",\n       SUM(seconds) / 3600.0 AS \"Hours\"\nFROM health.v_screentime_daily_app\nWHERE $__timeFilter(day)\nGROUP BY app\nORDER BY 2 DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisLabel": "hours",
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "App",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "id": 6
    },
    {
      "type": "barchart",
      "title": "When the phone gets used",
      "description": "Average minutes of screen time per hour of the local day, averaged across every day in the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH span AS (\n  SELECT GREATEST(COUNT(DISTINCT day), 1) AS n_days\n  FROM health.v_screentime_hourly\n  WHERE $__timeFilter(ts)\n)\nSELECT lpad(h.hour_of_day::text, 2, '0') AS \"Hour\",\n       SUM(h.seconds) / 60.0 / span.n_days AS \"Avg minutes\"\nFROM health.v_screentime_hourly h\nCROSS JOIN span\nWHERE $__timeFilter(h.ts)\nGROUP BY h.hour_of_day, span.n_days\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisLabel": "avg minutes",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Hour",
        "showValue": "never",
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Late-night use (22:00 - 02:00)",
      "description": "Minutes of screen time in the four hours around bedtime, attributed to the night it started - so 00:30 counts toward the previous day. This is the panel to overlay against ResMed sleep onset once that source lands.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN hour_of_day < 2 THEN day - interval '1 day' ELSE day END AS time,\n       SUM(seconds) / 60.0 AS \"Late-night minutes\"\nFROM health.v_screentime_hourly\nWHERE $__timeFilter(ts)\n  AND (hour_of_day >= 22 OR hour_of_day < 2)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#9085e9"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto",
            "pointSize": 5,
            "lineInterpolation": "smooth",
            "axisLabel": "minutes",
            "gradientMode": "none",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Daily breakdown by app",
      "description": "Stacked daily hours for the six largest apps in range; everything else folds into Other. Colors are pinned per app in the panel overrides, so a series keeps its colour when the ranking changes - add an override to pin a new app.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH top AS (\n  SELECT app\n  FROM health.v_screentime_daily_app\n  WHERE $__timeFilter(day)\n  GROUP BY app\n  ORDER BY SUM(seconds) DESC\n  LIMIT 6\n)\nSELECT a.day AS time,\n       CASE WHEN a.app IN (SELECT app FROM top) THEN a.app ELSE 'Other' END AS metric,\n       SUM(a.seconds) / 3600.0 AS value\nFROM health.v_screentime_daily_app a\nWHERE $__timeFilter(a.day)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "axisLabel": "hours",
            "gradientMode": "none",
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
