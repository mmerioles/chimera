          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Unlocks per day",
      "description": "Times the phone was unlocked per local day.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS time, unlocks AS \"Unlocks\"\nFROM health.v_screentime_daily\nWHERE $__timeFilter(day)\nORDER BY day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
