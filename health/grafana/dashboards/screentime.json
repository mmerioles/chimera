    {
      "type": "table",
      "title": "App detail",
      "description": "Per-app totals for the selected range. Doubles as the table view for the charts above, so no reading depends on colour alone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "health-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "health-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH totals AS (\n  SELECT SUM(seconds) AS all_seconds,\n         GREATEST(COUNT(DISTINCT day), 1) AS n_days\n  FROM health.v_screentime_daily_app\n  WHERE $__timeFilter(day)\n),\nopens AS (\n  SELECT e.display_name AS app, SUM(o.value) AS opens\n  FROM health.observations o\n  JOIN health.metrics  m ON m.id = o.metric_id\n  JOIN health.entities e ON e.id = o.entity_id\n  WHERE m.key = 'app_session_count' AND $__timeFilter(o.ts)\n  GROUP BY 1\n)\nSELECT a.app                                        AS \"App\",\n       SUM(a.seconds) / 3600.0                      AS \"Total hours\",\n       SUM(a.seconds) / 60.0 / t.n_days             AS \"Avg min/day\",\n       100.0 * SUM(a.seconds) / NULLIF(t.all_seconds, 0) AS \"Share %\",\n       COALESCE(op.opens, 0)                        AS \"Opens\",\n       SUM(a.seconds) / 60.0 / NULLIF(op.opens, 0)  AS \"Avg min/open\"\nFROM health.v_screentime_daily_app a\nCROSS JOIN totals t\nLEFT JOIN opens op ON op.app = a.app\nWHERE $__timeFilter(a.day)\nGROUP BY a.app, t.n_days, t.all_seconds, op.opens\nORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total hours"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
