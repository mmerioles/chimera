      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bord-supabase"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.name AS \"Venue\", count(ss.*) AS \"Sign-ups\"\nFROM venues v\nLEFT JOIN venue_slots s ON s.venue_id = v.id\nLEFT JOIN slot_signups ss ON ss.slot_id = s.id AND $__timeFilter(ss.created_at)\nWHERE v.state = 'approved'\nGROUP BY v.name ORDER BY 2 DESC, 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisBorderShow": false
