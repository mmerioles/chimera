    {
      "type": "table",
      "title": "Standing week",
      "description": "Every approved venue's nights, live seat counts, and how many people have signed up. Left = seats still open.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bord-supabase"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bord-supabase"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.name AS \"Venue\", v.neighborhood AS \"Area\", s.day AS \"Day\", s.time AS \"Time\",\n       s.seats_total AS \"Seats\", s.seats_left AS \"Left\",\n       (SELECT count(*) FROM slot_signups ss WHERE ss.slot_id = s.id) AS \"Signed up\"\nFROM venue_slots s JOIN venues v ON v.id = s.venue_id\nWHERE v.state = 'approved'\nORDER BY v.name,\n  array_position(ARRAY['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], s.day)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#c98500",
                      "value": null
                    },
                    {
                      "color": "#199e70",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "barchart",
      "title": "Sign-ups by venue",
      "description": "Seats taken per venue in the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bord-supabase"
      },
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 9
