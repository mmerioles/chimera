            "uid": "bord-supabase"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN sum(seats_total) = 0 THEN 0\n       ELSE 100.0 * sum(seats_total - seats_left) / sum(seats_total) END AS \"Seats filled\"\nFROM venue_slots",
